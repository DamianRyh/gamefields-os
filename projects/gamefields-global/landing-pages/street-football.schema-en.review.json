    {
      "@type": "FAQPage",
      "@id": "https://www.gamefields.eu/en/street-football-courts/#pytania",
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does a panna court cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Structures range from PLN 36,000 excluding VAT (Panna Cage 90) to PLN 100,000 excluding VAT (Street Arena 15). With a concrete slab and painting, Panna Play, for example, starts at PLN 51,000 excluding VAT. Installation, transport and site preparation are quoted after reviewing site photos."
          }
        },
        {
          "@type": "Question",
          "name": "What is included in the structure price?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The structure with goals in the basic configuration and standard colour. Surfacing, installation, transport and graphics are excluded. The price with surface adds a 12 cm concrete slab with sub-base and single-colour painting."
          }
        },
        {
          "@type": "Question",
          "name": "How does panna differ from 3v3 street football?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Panna is 1v1 play in a small enclosed arena: technique and playing the ball between an opponent's legs matter. 3v3 street football is fast team play on a larger boarded court, represented in our range by the 15 × 10 m Street Arena 15."
          }
        },
        {
          "@type": "Question",
          "name": "How much space does a panna court need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The smallest arenas are approximately 5 m in diameter, and the surface area with a 10% allowance starts at 21.5 m² (Panna Ring). A 3v3 court measures 15 × 10 m. Additional safety space is needed around it. Check your site dimensions in the “Will it fit?” planner."
          }
        },
        {
          "@type": "Question",
          "name": "Which arena is best for a school or residential community?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For schools and residential communities I usually recommend Panna Cage 90 (low and visually open) and Panna Play; for municipalities and parks, Panna Octa; for clubs and academies, Panna Cage 180 with a higher enclosure. The final choice depends on the site and age group."
          }
        },
        {
          "@type": "Question",
          "name": "Can I see the model before ordering?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. View each model in 3D, then choose the frame colour, surface and pattern in Studio and see the price immediately. Download the design as a PDF project sheet."
          }
        },
        {
          "@type": "Question",
          "name": "How long will the arena last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Panna Ring has stood at the OSiR Orlik facility in Grodzisk Mazowiecki for 10 years without damage. I provide a 12-month warranty and ongoing support after handover."
          }
        },
        {
          "@type": "Question",
          "name": "Can an arena be rented for an event?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Mobile event arena: rental and sale, from PLN 27,000 excluding VAT. It has been used at tournaments, championships and brand activations."
          }
        }
      ]
    }
