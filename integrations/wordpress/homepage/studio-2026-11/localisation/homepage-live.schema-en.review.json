    {
      "@type": "FAQPage",
      "@id": "https://www.gamefields.eu/en/#pytania",
      "inLanguage": "en-GB",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much space do I need for a court?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the selected structure and surrounding safety zone. Enter your site dimensions in the “Will it fit?” planner — you will see which models fit. Include approximate site dimensions in your enquiry."
          }
        },
        {
          "@type": "Question",
          "name": "Can I change the colours and patterns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. In GAMEFIELDS Studio you can create your own colour and graphics combination. We confirm the scope during project planning."
          }
        },
        {
          "@type": "Question",
          "name": "Do you also install surfaces separately?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Surfaces are the other half of my work alongside court structures: pattern design, painting, EPDM, tiles and turf. See how I transform old sites."
          }
        },
        {
          "@type": "Question",
          "name": "Can a court be built on old concrete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually, yes. If the concrete is stable, I repair cracks and defects, prime the substrate and apply a flexible sports coating with rubber granules, followed by graphics and markings. Severely damaged substrates need reconstruction first. I can assess this from photos. Old concrete, new court."
          }
        },
        {
          "@type": "Question",
          "name": "How long does site renovation take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on court size and initial site condition: the repairs, layers and number of colours required. Sports coatings are applied to dry concrete above freezing, so we usually work from spring to autumn. I confirm the schedule after reviewing photos. Send site photos."
          }
        },
        {
          "@type": "Question",
          "name": "Can I start without a finished design?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A description of the idea, approximate dimensions and site photos, if available, are enough. Send an enquiry to discuss the possibilities."
          }
        },
        {
          "@type": "Question",
          "name": "Can I see the price immediately?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Structures start at PLN 27,000 excluding VAT (mobile arena) and PLN 36,000 excluding VAT (Panna Octa Cage 90). The full list is in the section “How much does an arena cost?”. The cost of a complete court with surfacing, installation and transport depends on the site, so we prepare a detailed quotation after reviewing site photos. Budget factors are explained in our guide “How much does sports court construction cost?”."
          }
        }
      ]
    }
